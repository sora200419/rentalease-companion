{
  "name": "rentalease-companion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node scripts/test-workflows.mjs",
    "test:companion:http": "node scripts/smoke-companion.mjs",
    "model:serve": "node scripts/serve-local-model.mjs",
    "model:evaluate": "node scripts/evaluate-local-model.mjs",
    "dev": "next dev",
    "dev:companion": "node scripts/dev-companion.mjs",
    "dev:records": "node scripts/dev-records.mjs",
    "test:records:http": "node scripts/test-records-http.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:check:supabase": "node scripts/check-supabase.mjs",
    "db:initialize:supabase": "node scripts/initialize-supabase.mjs --apply",
    "db:seed:supabase": "node scripts/seed-supabase.mjs",
    "test:db-records": "node scripts/test-supabase-records.mjs",
    "test:db-config": "node --test tests/supabase-config.test.mjs",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "description": "RentalEase Move-Out Companion: an evidence-based tenancy assistant, built on the RentalEase FYP baseline.",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.5.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "ethers": "^6.16.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "resend": "^6.12.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^2.1.0",
    "@types/node": "20.19.41",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
