# Use a NEW development database. Never paste production credentials here.
# Copy this file to .env locally; real .env files must not be committed.
DATABASE_URL="postgresql://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/rentalease_companion?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Generate a new value: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""

# Required for the inherited login and expensive-endpoint rate limits.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Required when testing existing AI agreement features.
GEMINI_API_KEY=""

# Required when testing existing photo/proof uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional development-only email integration; use an approved test recipient.
RESEND_API_KEY=""
EMAIL_FROM=""

# Optional Sepolia anchoring; use a separate TESTNET wallet only.
SEPOLIA_RPC_URL=""
BLOCKCHAIN_PRIVATE_KEY=""

# Optional admin bootstrap: setting these can create or promote an account.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Needed only when enabling the tenancy-expiration scheduled endpoint.
CRON_SECRET=""
