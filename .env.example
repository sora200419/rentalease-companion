# Use a NEW development database. Never paste production credentials here.
# Copy this file to .env locally; real .env files must not be committed.
DATABASE_URL="postgresql://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/rentalease_companion?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Generate a new value: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""

# Required for the inherited login and expensive-endpoint rate limits.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Required when testing existing AI agreement features.
GEMINI_API_KEY=""

# Required when testing existing photo/proof uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional development-only email integration; use an approved test recipient.
RESEND_API_KEY=""
EMAIL_FROM=""

# Optional Sepolia anchoring; use a separate TESTNET wallet only.
SEPOLIA_RPC_URL=""
BLOCKCHAIN_PRIVATE_KEY=""

# Optional admin bootstrap: setting these can create or promote an account.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Needed only when enabling the tenancy-expiration scheduled endpoint.
CRON_SECRET=""

# Optional: exact name of an ALREADY INSTALLED local Ollama model.
# Blank keeps the rule-based assistant. No model downloads or cloud URLs are used.
COMPANION_OLLAMA_MODEL=""

# Optional: Amazon Bedrock for the /demo voice assistant (Alexa+ simulated experience).
# Blank keeps the credential-free rule assistant. Setting a model id opts in; the
# assistant then reads the case only through the RentalEase MCP tools.
# Malaysia/Singapore (ap-southeast-5 / ap-southeast-1) need inference-profile ids, e.g.
#   apac.amazon.nova-pro-v1:0   apac.amazon.nova-lite-v1:0   global.amazon.nova-2-lite-v1:0
# US regions: us.amazon.nova-pro-v1:0. See docs/VOICE-ASSISTANT.md.
COMPANION_BEDROCK_MODEL=""
# Region for Bedrock calls; falls back to AWS_REGION, then AWS_DEFAULT_REGION, then us-east-1.
COMPANION_BEDROCK_REGION=""
# Credentials use the standard AWS chain (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, AWS_PROFILE, ...)
# or a Bedrock API key below. Use a least-privilege key allowed to call bedrock:InvokeModel only.
# AWS_BEARER_TOKEN_BEDROCK=""
# Testing only: send Converse calls to a local stand-in (node scripts/mock-bedrock.mjs).
# COMPANION_BEDROCK_ENDPOINT="http://127.0.0.1:4599"
